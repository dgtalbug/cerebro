    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.14.0",
    "react": "^18.3.1",
    "react-d3-tree": "^3.6.6",
    "react-dom": "^18.3.1",
